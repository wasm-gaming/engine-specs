{
  "name": "@wasm-gaming/engine-specs",
  "version": "0.3.1",
  "description": "The wasm-gaming engine contract: the single shared JS API every WASM game/emulator engine and the host app conform to. TypeScript types, no runtime dependencies.",
  "type": "module",
  "types": "./dist/engine-specs.d.ts",
  "exports": {
    ".": {
      "types": "./dist/engine-specs.d.ts",
      "import": "./dist/engine-specs.js"
    }
  },
  "files": [
    "dist/",
    "demo/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasm-gaming/engine-specs.git"
  }
}
